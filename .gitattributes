# 统一按 LF 存进仓库，避免 Windows 提交把整个代码库改成 CRLF
* text=auto eol=lf

# 启动脚本例外：必须 CRLF + 纯 ASCII。
# cmd.exe 按控制台代码页解析 .bat，Windows PowerShell 按 ANSI 代码页解析无 BOM 的 .ps1，
# 两者都会把 UTF-8 中文读成乱码。这条规则由 npm run check 的断言守住。
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制，不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.woff  binary
*.woff2 binary
